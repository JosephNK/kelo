{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/cleanup-old-versions.sh\"",
            "description": "Remove stale kelo cache versions, keep only the active one"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/enforce-commit-skill.sh\"",
            "description": "Detect commit intent and force kelo:commit skill invocation"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/block-dangerous-commands.sh\"",
            "description": "Block dangerous commands (rm , db, chmod)"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/block-destructive-git.sh\"",
            "description": "Block destructive git commands (stash, reset --hard, clean -f, push --force, rebase, commit --amend 등)"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/block-lint-config-edits.sh\"",
            "description": "Block shell writes to kelo-managed lint config files (eslint.config.mjs, stylelint.config.mjs, kelo.lint.json, analysis_options.yaml, .kelo/plugins/**)"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/block-lint-config-edits.sh\"",
            "description": "Block edits to kelo-managed lint config files (eslint.config.mjs, stylelint.config.mjs, kelo.lint.json, analysis_options.yaml, .kelo/plugins/**)"
          }
        ]
      }
    ]
  }
}
